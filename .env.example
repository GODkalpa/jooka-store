# ==============================================================================
# JOOKA E-COMMERCE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL (Frontend)
NEXT_PUBLIC_APP_URL=https://jookawear.com

# ------------------------------------------------------------------------------
# 1. Medusa Backend Configuration (Oracle VPS / Hosted Backend)
# ------------------------------------------------------------------------------
# Set this to your live Medusa backend URL with HTTPS (e.g., https://api.jookawear.com)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.jookawear.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_medusa_publishable_key_here

# PostgreSQL Connection String (Medusa Server)
DATABASE_URL=postgres://user:password@your-postgres-host:5432/medusa_db

# ------------------------------------------------------------------------------
# 2. Cloudinary CDN Configuration (Image Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=jooka-store

# ------------------------------------------------------------------------------
# 3. Email Infrastructure (Resend OTP & Order Notification Service)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_verified_resend_api_key
FROM_EMAIL=noreply@jookawear.com
ADMIN_NOTIFICATION_EMAIL=orders@jookawear.com

# ------------------------------------------------------------------------------
# 4. Optional: SMTP Fallback Configuration
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key

# ------------------------------------------------------------------------------
# 5. Production Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
